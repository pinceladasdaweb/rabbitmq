{
  "name": "@pinceladasdaweb/rabbitmq",
  "version": "1.4.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "index.d.cts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs && cp index.d.ts index.d.cts",
    "hooks": "git config core.hooksPath .hooks",
    "prepack": "npm run build",
    "standard:fix": "standard --fix",
    "test": "node --test 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' 'tests/**/*.test.js'",
    "test:integration": "RABBITMQ_INTEGRATION=1 node --test 'tests/**/*.test.js'",
    "check:types": "tsc --noEmit --strict index.d.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rabbitmq",
    "amqp",
    "amqplib",
    "queues",
    "message-queue",
    "pubsub",
    "circuit-breaker",
    "rate-limiter",
    "dead-letter-queue",
    "delayed-messages",
    "worker-threads",
    "consumer",
    "producer"
  ],
  "author": "Pedro Rogério <pinceladasdaweb@hotmail.com>",
  "license": "MIT",
  "description": "A robust and elegant abstraction for RabbitMQ in Node.js, featuring advanced capabilities such as circuit breaker, intelligent retries, automatic compression, and parallel processing.",
  "devDependencies": {
    "@colors/colors": "^1.6.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "lint-staged": "^17.2.0",
    "rollup": "^4.62.3",
    "standard": "^17.1.2",
    "typescript": "^7.0.2",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "@cacheable/node-cache": "^3.1.1",
    "amqplib": "^2.0.1",
    "breakwater": "^0.5.3"
  },
  "lint-staged": {
    "src/**/*.js": "standard",
    "tests/**/*.js": "standard"
  },
  "repository": {
    "url": "git+https://github.com/pinceladasdaweb/rabbitmq.git"
  },
  "bugs": {
    "url": "https://github.com/pinceladasdaweb/rabbitmq/issues"
  },
  "homepage": "https://github.com/pinceladasdaweb/rabbitmq#readme"
}
