{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/*.test.js"
    ],
    "nodeArgs": [
      "--test",
      "--test-reporter=tap",
      "--test-timeout=2000",
      "--experimental-test-isolation=none"
    ]
  },
  "mutate": [
    "src/**/*.js"
  ],
  "plugins": [
    "@stryker-mutator/*",
    "./stryker-mutation-policy.js"
  ],
  "ignorers": [
    "mutation-policy"
  ],
  "coverageAnalysis": "perTest",
  "reporters": [
    "json",
    "html",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "clearTextReporter": {
    "maxTestsToLog": 1
  },
  "concurrency": 7,
  "timeoutMS": 2500,
  "timeoutFactor": 1,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
